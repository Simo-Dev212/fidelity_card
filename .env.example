# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database (Supabase Postgres via Prisma)
# ─────────────────────────────────────────────
# DATABASE_URL and DIRECT_URL are set in .env (not .env.example) with real credentials.
# Pattern: postgresql://nestapp:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public

# ─────────────────────────────────────────────
# JWT Auth
# ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# Google Wallet (Service Account)
# ─────────────────────────────────────────────
# 1. Create a Google Cloud project + enable "Google Wallet API"
# 2. Create a Service Account with role "Wallet Object Issuer"
# 3. Download the JSON key and extract:
GOOGLE_WALLET_ISSUER_ID="3388000000022xxxxxx"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gservice2.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_WALLET_CLASS_SUFFIX="loyalty"

# ─────────────────────────────────────────────
# Apple Wallet (PassKit)
# ─────────────────────────────────────────────
# Get these from developer.apple.com:
#   - Pass Type ID (e.g. pass.com.bigdwich.loyalty)
#   - Team ID (found in Membership details)
#   - Signer cert: your Pass signing certificate (export .p12 → convert to PEM)
#   - Signer key: private key for the signing cert
#   - WWDR cert: Apple WWDR G3 intermediate certificate
# All three certs can be set as PEM strings or file paths.
APPLE_PASS_TYPE_IDENTIFIER="pass.com.bigdwich.loyalty"
APPLE_TEAM_IDENTIFIER="BIGDWH01"
# Option A: inline PEM strings
# APPLE_SIGNER_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
# APPLE_SIGNER_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APPLE_WWDR_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
# Option B: file paths
# APPLE_SIGNER_CERT_PATH="/path/to/signer.pem"
# APPLE_SIGNER_KEY_PATH="/path/to/signer-key.pem"
# APPLE_WWDR_CERT_PATH="/path/to/wwdr.pem"
APPLE_SIGNER_KEY_PASSPHRASE=""

# ─────────────────────────────────────────────
# Webhook security
# ─────────────────────────────────────────────
WEBHOOK_SECRET="a-very-long-random-secret-shared-with-pos-or-crm"

# ─────────────────────────────────────────────
# Optional OAuth (Phase 1 can work with email/password only)
# ─────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
